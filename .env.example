# Opcional. Solo lo lee el servicio CHATBOT (en Docker y con scripts.run_all).
# Los tokens y llaves de los servicios NO van aquí: se generan en secrets/
# con `python -m scripts.setup_secrets`.

# Modelo que responde en el chat:
#   local     -> asistente Andi entrenado localmente (por defecto, sin API key)
#   anthropic -> Claude vía API
#   openai    -> GPT vía API (requiere `pip install openai`), o una API compatible
#                con OpenAI como Gemini (poner también CHATBOT_OPENAI_BASE_URL)
CHATBOT_LLM_PROVIDER=local
CHATBOT_ANTHROPIC_API_KEY=
CHATBOT_OPENAI_API_KEY=
CHATBOT_LLM_MODEL=claude-haiku-5-5
CHATBOT_OPENAI_MODEL=gpt-4o-mini
# Vacío = API de OpenAI. Para Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
CHATBOT_OPENAI_BASE_URL=
