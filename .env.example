# Copia este archivo a .env y completa lo que necesites.

# "anthropic", "openai" o "mock" (mock no requiere API key y sirve para
# probar toda la infraestructura sin gastar créditos de API).
LLM_PROVIDER=mock

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-3-5-haiku-latest

# Carpeta donde se escriben los logs (montada como volumen en Docker)
LOG_DIR=logs
