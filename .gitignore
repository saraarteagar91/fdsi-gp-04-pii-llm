.venv/
.venv*/
__pycache__/
*.pyc
.pytest_cache/
.env

# SECRETOS: llaves y tokens de cada servicio. Nunca se suben al repositorio
# (se generan con `python -m scripts.setup_secrets`).
secrets/

# Datos generados en tiempo de ejecución: logs de conversación y la bóveda
# (datos cifrados + bitácora de accesos).
logs/*.jsonl
data/vault/
data/db/
data/*.enc.jsonl

# El chatbot entrenado se regenera con `python -m scripts.train_bot` (o al
# arrancar). El modelo guardián (models/guardian_ner/) SÍ se versiona.
models/*.joblib

# OJO: data/evaluation_*.{csv,json,png} y data/guardian_primera_medicion.json
# NO se ignoran: son la evidencia de los resultados para la entrega.
